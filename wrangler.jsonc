{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karna",
  "compatibility_date": "2026-02-15",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karna-production",
      "database_id": "047e293b-5d55-452c-a901-5c029cb07ad9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "karna-documents"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "document-chunks"
    }
  ],
  // Environment secrets (set via wrangler secret put or .dev.vars for local):
  // GOOGLE_CLIENT_ID — OAuth 2.0 Client ID from Google Cloud Console
  // GOOGLE_CLIENT_SECRET — OAuth 2.0 Client Secret from Google Cloud Console
  // ENABLE_RENDER_PROXY — set to true to route API traffic through Render
  // RENDER_BACKEND_URL — https://<your-render-service>.onrender.com
  // RENDER_API_SECRET — shared secret used by Cloudflare proxy -> Render
  // RENDER_PROXY_TIMEOUT_MS — proxy timeout in milliseconds (default 8000)
}
